#!/bin/sh

# Get staged TypeScript files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(tsx?|ts|json)$' || true)

if [ -n "$STAGED_FILES" ]; then

# Format and lint staged files

bunx oxfmt --no-error-on-unmatched-pattern $STAGED_FILES
bunx oxlint --fix $STAGED_FILES

# Re-add formatted files

git add $STAGED_FILES
fi

# Check TypeScript types
bun run check:types

# Run all tests
bun test
