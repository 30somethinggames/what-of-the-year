{
  "ignorePatterns": [".github/**", "README.md"],
  "experimentalSortImports": {
    "groups": [["builtin"], ["external"], [""], ["internal", "parent", "sibling", "index"]],
    "newlinesBetween": true,
    "internalPattern": [
      "app",
      "components",
      "constants",
      "hooks",
      "queries",
      "types",
      "utils",
      "db",
      "screens"
    ]
  }
}
