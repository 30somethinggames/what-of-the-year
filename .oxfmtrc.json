{
  "ignorePatterns": [
    ".github/**",
    "README.md",
    "convex/_generated/**",
    "convex/convex.config.ts",
    "src/routeTree.gen.ts",
    "docs/**"
  ],
  "sortImports": {
    "groups": [["builtin"], ["external"], ["internal"], ["parent", "sibling", "index"]],
    "newlinesBetween": true,
    "internalPattern": [
      "app",
      "components",
      "constants",
      "hooks",
      "queries",
      "types",
      "utils",
      "db",
      "screens",
      "convex",
      "services"
    ]
  }
}
