# Copy this file to .env.local and fill in values for your dev deployment.
#
# 1. Run `bunx convex dev` — this creates your dev deployment and writes CONVEX_DEPLOYMENT
# 2. Replace <your-deployment-slug> below with the slug from CONVEX_DEPLOYMENT (e.g. "rosy-anteater-532")
# 3. Generate a TEST_SECRET: openssl rand -hex 32
# 4. Set the same TEST_SECRET on your Convex deployment: bunx convex env set TEST_SECRET <value>

CONVEX_DEPLOYMENT=dev:<your-deployment-slug>
VITE_CONVEX_URL=https://<your-deployment-slug>.convex.cloud
CONVEX_SITE_URL=https://<your-deployment-slug>.convex.site
TEST_SECRET=<run: openssl rand -hex 32>
