{
  "ignorePatterns": [
    ".github/**",
    "README.md",
    "CHANGELOG.md",
    "convex/_generated/**",
    "convex/convex.config.ts",
    "src/routeTree.gen.ts",
    "docs/**"
  ],
  "rules": {
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/no-access-key": "error",
    "react/jsx-key": "error",
    "react/no-children-prop": "error",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "no-console": "warn",
    "import/no-default-export": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["screens/*/*"],
            "message": "Screen internals are private. Move shared functionality to a top-level dir (hooks/, utils/, db/, etc.)."
          },
          {
            "group": ["convex/*", "convex/**", "@convex-dev/auth/react"],
            "message": "The backend is reached through the seam. Add a hook in src/db (session state) or src/queries (topic data) and call that, and put anything both sides share in src/shared."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "convex/**",
        "src/db/**",
        "src/queries/**",
        "src/hooks/use-anonymous-auth.ts",
        "src/main.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["screens/*/*"],
                "message": "Screen internals are private. Move shared functionality to a top-level dir (hooks/, utils/, db/, etc.)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/**/*.tsx"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
