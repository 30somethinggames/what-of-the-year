{
  "name": "what-of-the-year",
  "version": "0.0.1",
  "private": true,
  "author": "Ryan Seery & Melissa DeLorenzo",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt .",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint .",
    "check:types": "bunx tsc --noEmit",
    "convex:dev": "bunx convex dev",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:web": "set -a && source .env.local && set +a && bunx playwright test",
    "test:web:ui": "set -a && source .env.local && set +a && bunx playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@convex-dev/auth": "0.0.94",
    "@convex-dev/rate-limiter": "0.3.2",
    "@fontsource-variable/inter": "5.2.8",
    "@sentry/react": "10.57.0",
    "@tanstack/react-query": "5.97.0",
    "@tanstack/react-router": "1.168.15",
    "clsx": "2.1.1",
    "convex": "1.41.0",
    "framer-motion": "12.40.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@sentry/vite-plugin": "5.3.0",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/router-plugin": "1.167.14",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "husky": "9.1.7",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "engines": {
    "bun": ">=1.3.6"
  }
}
