{
  "name": "what-of-the-year",
  "version": "0.0.1",
  "private": true,
  "author": "Ryan Seery",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "format": "oxfmt .",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint .",
    "check:styles": "bun run scripts/check-unused-styles.ts",
    "check:types": "bunx tsc --noEmit",
    "convex:dev": "bunx convex dev",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:e2e": "set -a && source .env.local && set +a && maestro test --include-tags=e2e .maestro/",
    "test:smoke": "maestro test .maestro/smoke/",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/core": "0.37.0",
    "@convex-dev/auth": "^0.0.91",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-async-storage/async-storage": "^3.0.1",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@tanstack/react-query": "^5.90.20",
    "convex": "^1.32.0",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-insights": "~0.10.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@dev-plugins/react-query": "^0.4.0",
    "@types/bun": "^1.3.6",
    "@types/react": "~19.1.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "bun": ">=1.3.6"
  }
}
