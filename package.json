{
  "name": "what-of-the-year",
  "version": "0.0.1",
  "private": true,
  "author": "Ryan Seery & Melissa DeLorenzo",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt .",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint .",
    "check:types": "bunx tsc --noEmit",
    "convex:dev": "bunx convex dev",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:web": "set -a && source .env.local && set +a && bunx playwright test",
    "test:web:ui": "set -a && source .env.local && set +a && bunx playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@convex-dev/auth": "^0.0.91",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@sentry/react": "^10.50.0",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-router": "^1.168.25",
    "clsx": "^2.1.1",
    "convex": "^1.36.1",
    "framer-motion": "^12.38.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sentry/vite-plugin": "^5.2.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/router-plugin": "^1.167.28",
    "@types/bun": "^1.3.13",
    "@types/react": "~19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.10"
  },
  "engines": {
    "bun": ">=1.3.6"
  }
}
