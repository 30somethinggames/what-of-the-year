{
  "name": "what-of-the-year",
  "version": "0.0.1",
  "private": true,
  "author": "Ryan Seery & Melissa DeLorenzo",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt .",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint .",
    "check:types": "bunx tsc --noEmit",
    "convex:dev": "bunx convex dev",
    "test": "bun test --coverage",
    "test:watch": "bun test --watch",
    "test:web": "set -a && source .env.local && set +a && bunx playwright test",
    "test:web:ui": "set -a && source .env.local && set +a && bunx playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@convex-dev/auth": "0.0.95",
    "@convex-dev/rate-limiter": "0.3.2",
    "@fontsource-variable/inter": "5.3.0",
    "@sentry/react": "10.73.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.32",
    "clsx": "2.1.1",
    "convex": "1.45.0",
    "framer-motion": "13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@sentry/vite-plugin": "5.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.35",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "convex-test": "0.0.56",
    "husky": "9.1.7",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "engines": {
    "bun": ">=1.3.6"
  }
}
